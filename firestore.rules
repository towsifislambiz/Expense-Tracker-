rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all access to unmapped root collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User document tree isolation with recursive wildcard protecting all subcollections
    // (profile, settings, notifications, transactions, budgets, categories)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
